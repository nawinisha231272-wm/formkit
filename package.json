{
  "name": "ourform",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm size",
    "dev": "pnpm build && pnpm --filter @ourform/playground dev",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@axe-core/playwright": "4.10.2",
    "@changesets/cli": "2.29.4",
    "@eslint/js": "9.28.0",
    "@ourform/builder-core": "workspace:*",
    "@ourform/components": "workspace:*",
    "@ourform/core": "workspace:*",
    "@ourform/renderer-dom": "workspace:*",
    "@ourform/schema": "workspace:*",
    "@ourform/sdk": "workspace:*",
    "@ourform/testing": "workspace:*",
    "@ourform/theme-base": "workspace:*",
    "@ourform/theme-bootstrap5": "workspace:*",
    "@ourform/theme-tailwind": "workspace:*",
    "@playwright/test": "1.56.1",
    "@size-limit/file": "11.2.0",
    "@types/node": "22.15.29",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "3.2.4",
    "ajv": "8.17.1",
    "bootstrap": "5.3.8",
    "esbuild": "0.25.12",
    "eslint": "9.28.0",
    "pnpm": "10.10.0",
    "prettier": "3.5.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rxjs": "7.8.2",
    "size-limit": "11.2.0",
    "tsup": "8.5.0",
    "turbo": "2.5.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "6.3.5",
    "vitest": "3.2.4",
    "@ourform/element": "workspace:*",
    "@ourform/react": "workspace:*",
    "@ourform/angular": "workspace:*",
    "@angular/forms": "22.2.3",
    "@ourform/theme-bootstrap4": "workspace:*",
    "bootstrap4": "npm:bootstrap@4.6.2"
  },
  "size-limit": [
    {
      "name": "schema",
      "path": "packages/schema/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "core",
      "path": "packages/core/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "sdk",
      "path": "packages/sdk/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "components",
      "path": "packages/components/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "renderer-dom",
      "path": "packages/renderer-dom/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "builder-core",
      "path": "packages/builder-core/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "theme-base",
      "path": "packages/theme-base/dist/index.js",
      "limit": "10 kB"
    },
    {
      "name": "theme-bootstrap5",
      "path": "packages/theme-bootstrap5/dist/index.js",
      "limit": "10 kB"
    },
    {
      "name": "theme-tailwind",
      "path": "packages/theme-tailwind/dist/index.js",
      "limit": "10 kB"
    },
    {
      "name": "element",
      "path": "packages/element/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "react",
      "path": "packages/react/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "angular",
      "path": "packages/angular/dist/fesm2022/ourform-angular.mjs",
      "limit": "30 kB"
    },
    {
      "name": "theme-bootstrap4",
      "path": "packages/theme-bootstrap4/dist/index.js",
      "limit": "10 kB"
    }
  ]
}
