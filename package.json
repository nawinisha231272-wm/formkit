{
  "name": "ourform",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm size",
    "dev": "pnpm build && pnpm --filter @ourform/playground dev",
    "changeset": "changeset"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "pnpm": "10.10.0",
    "turbo": "2.5.3",
    "tsup": "8.5.0",
    "vitest": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "@playwright/test": "1.56.1",
    "@axe-core/playwright": "4.10.2",
    "eslint": "9.28.0",
    "@eslint/js": "9.28.0",
    "typescript-eslint": "8.33.1",
    "prettier": "3.5.3",
    "size-limit": "11.2.0",
    "@size-limit/file": "11.2.0",
    "@changesets/cli": "2.29.4",
    "vite": "6.3.5",
    "@types/node": "22.15.29",
    "@ourform/schema": "workspace:*",
    "@ourform/core": "workspace:*",
    "@ourform/sdk": "workspace:*",
    "@ourform/components": "workspace:*",
    "@ourform/builder-core": "workspace:*",
    "@ourform/renderer-dom": "workspace:*",
    "ajv": "8.17.1"
  },
  "size-limit": [
    {
      "name": "schema",
      "path": "packages/schema/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "core",
      "path": "packages/core/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "sdk",
      "path": "packages/sdk/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "components",
      "path": "packages/components/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "renderer-dom",
      "path": "packages/renderer-dom/dist/index.js",
      "limit": "30 kB"
    },
    {
      "name": "builder-core",
      "path": "packages/builder-core/dist/index.js",
      "limit": "30 kB"
    }
  ]
}
