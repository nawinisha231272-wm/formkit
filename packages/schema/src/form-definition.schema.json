{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ourform.dev/schema/form-definition-1.0.json",
  "type": "object",
  "properties": {
    "$formVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "display": {
      "enum": ["form", "wizard"]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "plugin": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": ["plugin", "version"],
        "additionalProperties": false
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string"
        },
        "validateOn": {
          "enum": ["change", "blur", "submit"]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "required": ["$formVersion", "id", "display", "components"],
  "additionalProperties": false,
  "$defs": {
    "expr": {
      "anyOf": [
        {
          "type": ["null", "boolean", "number", "string"]
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string"
            }
          },
          "required": ["ref"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": ["path"],
          "additionalProperties": false
        },
        {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "enum": [
                "and",
                "or",
                "not",
                "eq",
                "neq",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "add",
                "sub",
                "mul",
                "div",
                "mod",
                "if",
                "empty",
                "len",
                "sum",
                "min",
                "max",
                "concat",
                "call"
              ]
            }
          ],
          "items": {
            "$ref": "#/$defs/expr"
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "defaultValue": {},
        "validation": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "minLength": {
              "type": "integer",
              "minimum": 0
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "pattern": {
              "type": "string"
            },
            "minItems": {
              "type": "integer",
              "minimum": 0
            },
            "maxItems": {
              "type": "integer",
              "minimum": 0
            },
            "custom": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "validator": {
                    "type": "string"
                  },
                  "args": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/expr"
                    }
                  }
                },
                "required": ["validator"],
                "additionalProperties": false
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "visibleWhen": {
          "$ref": "#/$defs/expr"
        },
        "disabledWhen": {
          "$ref": "#/$defs/expr"
        },
        "calculate": {
          "type": "object",
          "properties": {
            "expr": {
              "$ref": "#/$defs/expr"
            },
            "allowOverride": {
              "type": "boolean"
            }
          },
          "required": ["expr"],
          "additionalProperties": false
        },
        "clearOnHide": {
          "type": "boolean"
        },
        "properties": {
          "type": "object"
        },
        "layout": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "meta": {
          "type": "object"
        }
      },
      "required": ["id", "type"],
      "additionalProperties": false
    }
  }
}
