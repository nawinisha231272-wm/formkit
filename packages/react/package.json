{
  "name": "@ourform/react",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ourform/core": "workspace:*",
    "@ourform/schema": "workspace:*",
    "@ourform/sdk": "workspace:*",
    "@ourform/renderer-dom": "workspace:*",
    "@ourform/components": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
