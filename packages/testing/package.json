{
  "name": "@ourform/testing",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/playwright.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ourform/builder-core": "workspace:*",
    "@ourform/schema": "workspace:*",
    "@ourform/core": "workspace:*",
    "@ourform/sdk": "workspace:*",
    "@ourform/components": "workspace:*",
    "@ourform/renderer-dom": "workspace:*",
    "@ourform/theme-base": "workspace:*",
    "@ourform/theme-bootstrap5": "workspace:*",
    "@ourform/theme-tailwind": "workspace:*",
    "@ourform/theme-bootstrap4": "workspace:*",
    "@ourform/validation": "workspace:*",
    "@ourform/theme-material": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": "1.56.1",
    "@axe-core/playwright": "4.10.2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@axe-core/playwright": {
      "optional": true
    }
  }
}
